# 面板登录密码（至少 8 位）
PANEL_PASSWORD=
# 加密密钥：openssl rand -base64 32。丢了就解不开已保存的密码和订阅，务必备份
SECRET_KEY=
# 面板网址（Cloudflare Tunnel 绑定的域名），用于生成订阅链接
PUBLIC_URL=https://panel.example.com
# Cloudflare Tunnel Token（Zero Trust → Networks → Tunnels → 创建隧道后获得）
TUNNEL_TOKEN=

# 中转（小火箭扫码直连）：手机连接的地址和端口。填 VPS 公网 IP；留空则不开启中转
RELAY_HOST=
RELAY_PORT=443
# Reality 伪装的网站，一般不用改
REALITY_SNI=www.microsoft.com

# Telegram 通知和每日备份：@BotFather 创建机器人后拿到的 Token，留空则不开启
TG_BOT_TOKEN=

# 订阅同步和链路检测间隔
SYNC_EVERY=30m
CHECK_EVERY=15m
